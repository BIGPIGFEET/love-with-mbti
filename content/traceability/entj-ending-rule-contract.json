  "rules": [
    {
      "auditRuleId": "ENTJ-AUDIT-R-GLOBAL-CONFLICT-80",
      "scope": "global",
      "checkpoint": "after_every_choice",
      "when": "conflict >= 80",
      "inclusive": true,
      "result": "conflict_break"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-GLOBAL-COMFORT-05",
      "scope": "global",
      "checkpoint": "after_every_choice",
      "when": "comfort <= 5",
      "inclusive": true,
      "result": "strong_discomfort"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-GLOBAL-TRUST-05",
      "scope": "global",
      "checkpoint": "after_every_choice",
      "when": "trust <= 5",
      "inclusive": true,
      "result": "trust_broken"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-GATE-Q02",
      "scope": "checkpoint",
      "checkpoint": "after_Q02",
      "when": "NOT (attraction >= 25 AND trust >= 20 AND comfort >= 20 AND conflict <= 20)",
      "inclusive": "mixed",
      "result": "no_second_meeting"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-GATE-Q05",
      "scope": "checkpoint",
      "checkpoint": "after_Q05",
      "when": "NOT (attraction >= 35 AND trust >= 30 AND comfort >= 25 AND conflict <= 45)",
      "inclusive": "mixed",
      "result": "fade_out"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-GATE-Q08",
      "scope": "checkpoint",
      "checkpoint": "after_Q08",
      "when": "NOT (attraction >= 45 AND trust >= 40 AND comfort >= 35 AND conflict <= 45)",
      "inclusive": "mixed",
      "result": "stay_acquaintances"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-FINAL-STRANGERS",
      "scope": "final",
      "checkpoint": "after_Q10",
      "when": "trust < 35 OR comfort < 35 OR conflict > 50",
      "inclusive": false,
      "result": "strangers_after_all"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-FINAL-CONFIRMED",
      "scope": "final",
      "checkpoint": "after_Q10",
      "when": "attraction >= 85 AND trust >= 65 AND comfort >= 60 AND conflict <= 25",
      "inclusive": true,
      "result": "confirmed_relationship",
      "secondaryEvaluation": "romance_stable if trust >= 75 AND comfort >= 70 AND conflict <= 15; otherwise romance_hidden_risk"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-FINAL-DANGEROUS",
      "scope": "final",
      "checkpoint": "after_Q10",
      "when": "attraction >= 90 AND (trust < 65 OR comfort < 60)",
      "inclusive": "mixed",
      "result": "dangerous_lovers"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-FINAL-FRIENDS",
      "scope": "final",
      "checkpoint": "after_Q10",
      "when": "attraction < 65 AND trust >= 50 AND comfort >= 45 AND conflict <= 40",
      "inclusive": "mixed",
      "result": "friends"
    },
    {
      "auditRuleId": "ENTJ-AUDIT-R-FINAL-AMBIGUOUS",
      "scope": "final",
      "checkpoint": "after_Q10",
      "when": "no earlier rule matched",
      "inclusive": "n/a",
      "result": "unresolved_ambiguity"
    }
  ],
